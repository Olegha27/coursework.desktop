<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.courseworkitfu.fxControllers.dishes.CreateDishForm">

    <children>
        <Label layoutX="20.0" layoutY="20.0"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"
               text="Create Dish"/>

        <Label layoutX="20.0" layoutY="60.0" text="Title"/>
        <TextField fx:id="titleField"
                   layoutX="170.0" layoutY="56.0"
                   prefWidth="280.0"
                   promptText="Dish title"/>

        <Label layoutX="20.0" layoutY="95.0" text="Price"/>
        <TextField fx:id="priceField"
                   layoutX="170.0" layoutY="91.0"
                   prefWidth="280.0"
                   promptText="0.00"/>

        <Label layoutX="20.0" layoutY="130.0" text="Calories"/>
        <TextField fx:id="caloriesField"
                   layoutX="170.0" layoutY="126.0"
                   prefWidth="280.0"
                   promptText="0"/>

        <Label layoutX="20.0" layoutY="165.0" text="Category"/>
        <TextField fx:id="categoryField"
                   layoutX="170.0" layoutY="161.0"
                   prefWidth="280.0"
                   promptText="Main / Dessert / Drink"/>

        <Label layoutX="20.0" layoutY="200.0" text="Description"/>
        <TextArea fx:id="descriptionField"
                  layoutX="170.0" layoutY="196.0"
                  prefWidth="280.0"
                  prefHeight="60.0"
                  promptText="Dish description"/>

        <Label layoutX="20.0" layoutY="270.0" text="Image URL"/>
        <TextField fx:id="imageUrlField"
                   layoutX="170.0" layoutY="266.0"
                   prefWidth="280.0"
                   promptText="https://..."/>

        <Label layoutX="20.0" layoutY="305.0" text="Preparation Time (min)"/>
        <TextField fx:id="preparationTimeField"
                   layoutX="170.0" layoutY="301.0"
                   prefWidth="280.0"
                   promptText="10"/>

        <Label layoutX="20.0" layoutY="340.0" text="Weight"/>
        <TextField fx:id="weightField"
                   layoutX="170.0" layoutY="336.0"
                   prefWidth="280.0"
                   promptText="100"/>

        <Label layoutX="20.0" layoutY="375.0" text="Available"/>
        <CheckBox fx:id="availableCheckBox"
                  layoutX="170.0" layoutY="373.0"
                  selected="true"/>

        <Label fx:id="errorLabel"
               layoutX="20.0" layoutY="405.0"
               prefWidth="430.0"
               wrapText="true"
               textFill="RED"/>

        <Button layoutX="170.0" layoutY="445.0"
                prefWidth="120.0"
                text="Save"
                onAction="#saveDish"/>

        <Button layoutX="330.0" layoutY="445.0"
                prefWidth="120.0"
                text="Cancel"
                onAction="#closeWindow"/>
    </children>
</AnchorPane>