<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.courseworkitfu.fxControllers.tabs.dishes.DishesTabController"
      spacing="12.0"
      style="-fx-background-color: #f7f7f7;">

    <padding>
        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
    </padding>

    <children>
        <Label text="Dish Management" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="10.0">
            <children>
                <Button text="Create Dish" onAction="#createDish" prefWidth="120.0"/>
                <Button text="Delete Dish" onAction="#deleteDish" prefWidth="120.0"/>
                <Button text="Refresh" onAction="#refreshDishes" prefWidth="120.0"/>
            </children>
        </HBox>

        <TableView fx:id="dishTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="55.0"/>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="140.0"/>
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="240.0"/>
                <TableColumn fx:id="priceColumn" text="Price" prefWidth="90.0"/>
                <TableColumn fx:id="weightColumn" text="Weight" prefWidth="90.0"/>
                <TableColumn fx:id="caloriesColumn" text="Calories" prefWidth="90.0"/>
                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120.0"/>
                <TableColumn fx:id="availableColumn" text="Available" prefWidth="90.0"/>
                <TableColumn fx:id="restaurantColumn" text="Restaurant" prefWidth="150.0"/>
            </columns>
        </TableView>
    </children>
</VBox>