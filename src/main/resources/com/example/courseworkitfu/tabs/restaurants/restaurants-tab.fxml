<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.courseworkitfu.fxControllers.tabs.restaurants.RestaurantsTabController">

    <children>
        <BorderPane prefHeight="720.0" prefWidth="1200.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <left>
                <VBox prefWidth="280.0" spacing="10.0"
                      style="-fx-background-color: white; -fx-border-color: #d9d9d9; -fx-border-width: 0 1 0 0;">
                    <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                    </padding>

                    <children>
                        <Label text="Restaurants" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Label text="Choose a restaurant to see its menu" style="-fx-text-fill: #666666;"/>

                        <ListView fx:id="restaurantList" VBox.vgrow="ALWAYS"
                                  style="-fx-background-radius: 10; -fx-border-radius: 10;"/>
                    </children>
                </VBox>
            </left>

            <center>
                <SplitPane dividerPositions="0.68">
                    <items>

                        <VBox spacing="12.0" style="-fx-background-color: #f7f7f7;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>

                            <children>
                                <Label fx:id="selectedRestaurantLabel"
                                       text="Select restaurant"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                                <ScrollPane fitToWidth="true"
                                            fitToHeight="true"
                                            VBox.vgrow="ALWAYS"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <content>
                                        <TilePane fx:id="dishTilePane"
                                                  prefColumns="4"
                                                  hgap="12.0"
                                                  vgap="12.0"
                                                  prefTileWidth="170.0"
                                                  prefTileHeight="205.0"
                                                  style="-fx-background-color: transparent;">
                                            <padding>
                                                <Insets top="4.0" right="4.0" bottom="4.0" left="4.0"/>
                                            </padding>
                                        </TilePane>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <VBox prefWidth="320.0" spacing="12.0"
                              style="-fx-background-color: white; -fx-border-color: #d9d9d9; -fx-border-width: 0 0 0 1;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>

                            <children>
                                <Label text="Cart" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                                <ListView fx:id="cartList"
                                          VBox.vgrow="ALWAYS"
                                          style="-fx-background-radius: 10; -fx-border-radius: 10;"/>

                                <Label text="Special instructions" style="-fx-font-weight: bold;"/>

                                <TextArea fx:id="specialInstructionsArea"
                                          prefRowCount="4"
                                          wrapText="true"
                                          promptText="Add delivery notes or special requests..."/>

                                <Label fx:id="cartTotalLabel"
                                       text="Total: $0.00"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                                <HBox spacing="10.0">
                                    <children>
                                        <Button text="Clear Cart"
                                                onAction="#clearCart"
                                                prefWidth="140.0"
                                                style="-fx-background-color: #eeeeee; -fx-font-weight: bold;"/>

                                        <Button text="Place Order"
                                                onAction="#placeOrder"
                                                prefWidth="140.0"
                                                style="-fx-background-color: #2d8cff; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </items>
                </SplitPane>
            </center>

        </BorderPane>
    </children>
</AnchorPane>