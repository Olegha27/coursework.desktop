<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.courseworkitfu.fxControllers.tabs.orders.OrdersTabController"
      spacing="12.0"
      style="-fx-background-color: #f7f7f7;">

    <padding>
        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
    </padding>

    <children>
        <Label text="Order Management" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="8.0">
            <children>
                <TextField fx:id="orderSearchField"
                           promptText="Search by id, client, restaurant, driver or status"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Search" onAction="#searchOrders" prefWidth="100.0"/>
                <Button text="Reset" onAction="#resetOrderSearch" prefWidth="100.0"/>
                <Button text="Refresh" onAction="#refreshOrders" prefWidth="100.0"/>
            </children>
        </HBox>

        <SplitPane dividerPositions="0.70" VBox.vgrow="ALWAYS">
            <items>

                <VBox spacing="10.0">
                    <children>
                        <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="55.0"/>
                                <TableColumn fx:id="clientColumn" text="Client" prefWidth="120.0"/>
                                <TableColumn fx:id="restaurantColumn" text="Restaurant" prefWidth="130.0"/>
                                <TableColumn fx:id="driverColumn" text="Driver" prefWidth="120.0"/>
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="120.0"/>
                                <TableColumn fx:id="totalPriceColumn" text="Total" prefWidth="90.0"/>
                                <TableColumn fx:id="createdAtColumn" text="Created At" prefWidth="170.0"/>
                                <TableColumn fx:id="paymentMethodColumn" text="Payment" prefWidth="100.0"/>
                            </columns>
                        </TableView>

                        <HBox spacing="8.0">
                            <children>
                                <Button text="Confirm" onAction="#confirmOrder" prefWidth="100.0"/>
                                <Button text="Preparing" onAction="#prepareOrder" prefWidth="100.0"/>
                                <Button text="Ready" onAction="#readyForPickupOrder" prefWidth="100.0"/>
                                <Button text="Complete" onAction="#completeOrder" prefWidth="100.0"/>
                                <Button text="Cancel" onAction="#cancelOrder" prefWidth="100.0"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0" prefWidth="320.0" style="-fx-background-color: white; -fx-border-color: #dddddd; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <padding>
                        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                    </padding>

                    <children>
                        <Label text="Order Messages" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

                        <ListView fx:id="orderMessagesList" VBox.vgrow="ALWAYS"/>

                        <TextArea fx:id="newMessageArea"
                                  promptText="Type a message..."
                                  wrapText="true"
                                  prefRowCount="4"/>

                        <Button text="Send Message" onAction="#sendMessage" prefWidth="140.0"/>
                    </children>
                </VBox>

            </items>
        </SplitPane>
    </children>
</VBox>